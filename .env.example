# ==============================================================================
# SAATH Environment Configuration (.env.example)
# All variables are OPTIONAL. SAATH works 100% offline out-of-the-box.
# ==============================================================================

# Database Path (defaults to data/saath.db inside project root)
SAATH_DB_PATH=data/saath.db

# Ollama Local LLM Configuration (Default: Gemma 2B on http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:2b
SAATH_LLM_TIMEOUT_S=20.0

# Optional Partner Technology Integrations (Only if testing cloud services)
# ElevenLabs API Key for spoken audio check-ins (Optional - falls back to local TTS)
# ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Sentry Tracing DSN (Optional - tracks latency & error traces)
# SENTRY_DSN=https://your_sentry_dsn_here@sentry.io/project_id
